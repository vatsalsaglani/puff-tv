{
  "name": "puff-installer",
  "version": "0.1.0",
  "description": "Install Puff on your Android TV without terminal commands",
  "author": "Puff contributors",
  "license": "GPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.puff.installer",
    "productName": "Puff Installer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.cjs",
      "ui/**",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "zip"
      ],
      "identity": "-",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Puff Installer finds your Android TV on the local network to install Puff."
      }
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "Puff-Installer-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
